# ── Server-side only (never exposed to the browser) ──────────────────

# athenahealth EHR API — OAuth 2.0 Client Credentials
# Register at https://developer.athenahealth.com
ATHENA_CLIENT_ID=
ATHENA_CLIENT_SECRET=
ATHENA_ENV=preview

# Google Places API (used by /api/places)
GOOGLE_PLACES_API_KEY=

# Google Maps Embed + Static Maps API (used by /api/maps)
GOOGLE_MAPS_SERVER_KEY=

# Stedi Healthcare API — 837P claim submission
# Get yours at https://portal.stedi.com/app/settings/api-keys
STEDI_API_KEY=

# ElevenLabs Text-to-Speech API
# Get yours at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# GitHub Personal Access Token — used by /api/dev/* routes to write
# to src/data/blog.ts (blog status / images / release dates) without a
# local clone. Needs `contents:write` scope on the worrellburton/sam repo.
GITHUB_TOKEN=

# Anthropic + Gemini keys power /api/dev/generate-prompt and
# /api/dev/generate-image respectively. Optional unless you use those.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Required in production to unlock the /dev UI and /api/dev/* routes.
# Any non-empty string; treat like a password. Without this set, the
# dev panel fails closed (503). See src/lib/dev-auth.ts for details.
DEV_PANEL_SECRET=

# Google Search Console verification token (HTML tag method). Paste the
# `content="..."` value from the meta tag Google gives you. Optional —
# only needed during initial property verification, then can stay set.
GOOGLE_SITE_VERIFICATION=

# ── Client-side (NEXT_PUBLIC_ prefix, safe for the browser) ─────────

# Site URL used for SEO / canonical links (defaults to https://sammd.vercel.app)
NEXT_PUBLIC_SITE_URL=

# Supabase (backend). Project: Supabase Sam
NEXT_PUBLIC_SUPABASE_URL=https://wgznytmxwslupjhsdeha.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable__NakM2zJsFHyqQ10z3cIlQ_o2AGkF_D

# athenahealth environment and practice ID (non-secret)
NEXT_PUBLIC_ATHENA_ENV=preview
NEXT_PUBLIC_ATHENA_PRACTICE_ID=
