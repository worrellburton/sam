# athenahealth EHR API (athenaOne)
# Register at https://developer.athenahealth.com
VITE_ATHENA_CLIENT_ID=your_athena_client_id_here
VITE_ATHENA_CLIENT_SECRET=your_athena_client_secret_here
VITE_ATHENA_PRACTICE_ID=your_practice_id_here
VITE_ATHENA_ENV=preview

# Stedi Healthcare API Key
# Get yours at https://portal.stedi.com/app/settings/api-keys
VITE_STEDI_API_KEY=your_stedi_api_key_here

# ElevenLabs Text-to-Speech API Key
# Get yours at https://elevenlabs.io/app/settings/api-keys
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
