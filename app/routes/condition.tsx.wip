import { Link, useParams } from "react-router";
import { getConditionBySlug } from "~/data/conditions";

export function meta({ params }: { params: { slug: string } }) {
  const condition = getConditionBySlug(params.slug);
  return [
    { title: condition ? `${condition.title} Treatment NYC | Dr. Sam Elguizaoui, M.D.` : "Condition Not Found" },
    { name: "description", content: condition?.description || "" },
  ];
}

export default function ConditionPage() {
  const { slug } = useParams();
  const condition = getConditionBySlug(slug || "");

  if (!condition) {
    return (
      <main style={{ padding: "4rem 2rem", textAlign: "center" }}>
        <h1>Condition Not Found</h1>
        <Link to="/">Return Home</Link>
      </main>
    );
  }

  return (
    <>
      {/* Hero */}
      <section className="cond-hero">
        <div className="container">
          <Link to={`/services/${condition.service}`} className="svc-back-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
              <polyline points="15 18 9 12 15 6" />
            </svg>
            Back to Service
          </Link>
          <h1>{condition.title}</h1>
          <p className="cond-hero-text">{condition.hero}</p>
          <div className="cond-hero-actions">
            <Link to="/book" className="btn btn-primary">Book a Consultation</Link>
            <a href="tel:+19179059370" className="btn btn-outline">(917) 905-9370</a>
          </div>
        </div>
      </section>

      {/* Overview */}
      <section className="cond-section">
        <div className="container cond-container">
          <div className="cond-section-header">
            <p className="section-label">Understanding Your Condition</p>
            <h2>What Is {condition.title}?</h2>
          </div>
          <div className="cond-overview">
            {condition.overview.split("\n\n").map((p, i) => (
              <p key={i}>{p}</p>
            ))}
          </div>
        </div>
      </section>

      {/* Symptoms & Causes side by side */}
      <section className="cond-section cond-section-alt">
        <div className="container cond-container">
          <div className="cond-two-col">
            <div>
              <h2>Common Symptoms</h2>
              <p className="cond-sub">If you&rsquo;re experiencing any of these, it may be time to see a specialist.</p>
              <ul className="cond-check-list">
                {condition.symptoms.map((s, i) => (
                  <li key={i}>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                    {s}
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <h2>Common Causes</h2>
              <p className="cond-sub">Understanding what led to your condition helps us create the right treatment plan.</p>
              <ul className="cond-check-list cond-causes-list">
                {condition.causes.map((c, i) => (
                  <li key={i}>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                      <circle cx="12" cy="12" r="10" />
                      <line x1="12" y1="8" x2="12" y2="12" />
                      <line x1="12" y1="16" x2="12.01" y2="16" />
                    </svg>
                    {c}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>

      {/* Treatment Options */}
      <section className="cond-section">
        <div className="container cond-container">
          <div className="cond-section-header">
            <p className="section-label">Your Options</p>
            <h2>Treatment Approaches</h2>
          </div>
          <div className="cond-treatments">
            {condition.treatments.map((t, i) => (
              <div className="cond-treatment-card" key={i}>
                <div className="cond-treatment-num">{i + 1}</div>
                <div>
                  <h3>{t.name}</h3>
                  <p>{t.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* Recovery */}
      <section className="cond-section cond-section-alt">
        <div className="container cond-container">
          <div className="cond-recovery">
            <div className="cond-recovery-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
              </svg>
            </div>
            <h2>Recovery &amp; What to Expect</h2>
            <p>{condition.recovery}</p>
          </div>
        </div>
      </section>

      {/* FAQ */}
      <section className="cond-section">
        <div className="container cond-container">
          <div className="cond-section-header">
            <p className="section-label">Common Questions</p>
            <h2>Frequently Asked Questions</h2>
          </div>
          <div className="cond-faq">
            {condition.faq.map((f, i) => (
              <details className="cond-faq-item" key={i}>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      {/* CTA */}
      <section className="svc-cta">
        <div className="container" style={{ textAlign: "center" }}>
          <h2>Take the First Step Toward Relief</h2>
          <p>You don&rsquo;t have to live with pain. Schedule a consultation with Dr. Elguizaoui to discuss your treatment options.</p>
          <div style={{ display: "flex", gap: "12px", justifyContent: "center", marginTop: "24px", flexWrap: "wrap" }}>
            <Link to="/book" className="btn btn-primary">Book Appointment</Link>
            <Link to="/contact" className="btn btn-outline" style={{ borderColor: "rgba(255,255,255,0.3)", color: "#fff" }}>Contact Us</Link>
          </div>
        </div>
      </section>
    </>
  );
}
