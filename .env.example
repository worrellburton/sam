# ── Server-side only (never exposed to the browser) ──────────────────

# athenahealth EHR API — OAuth 2.0 Client Credentials
# Register at https://developer.athenahealth.com
ATHENA_CLIENT_ID=
ATHENA_CLIENT_SECRET=
ATHENA_ENV=preview

# Google Places API (used by /api/places)
GOOGLE_PLACES_API_KEY=

# Google Maps Embed + Static Maps API (used by /api/maps)
GOOGLE_MAPS_SERVER_KEY=

# Stedi Healthcare API — 837P claim submission
# Get yours at https://portal.stedi.com/app/settings/api-keys
STEDI_API_KEY=

# ElevenLabs Text-to-Speech API
# Get yours at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# ── Client-side (NEXT_PUBLIC_ prefix, safe for the browser) ─────────

# Site URL used for SEO / canonical links (defaults to https://sammd.vercel.app)
NEXT_PUBLIC_SITE_URL=

# athenahealth environment and practice ID (non-secret)
NEXT_PUBLIC_ATHENA_ENV=preview
NEXT_PUBLIC_ATHENA_PRACTICE_ID=
